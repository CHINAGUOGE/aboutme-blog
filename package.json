{
  "name": "guogepige-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "果鸽的个人博客 — Oniichan Style",
  "scripts": {
    "dev": "tsx scripts/color-extract.ts && astro dev",
    "build": "bash build.sh",
    "build:astro": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "validate-config": "tsx scripts/validate-config.mjs",
    "validate-music": "tsx scripts/validate-music.mjs",
    "optimize-assets": "tsx scripts/optimize-assets.mjs",
    "extract-theme": "tsx scripts/color-extract.ts",
    "new-post": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "@astrojs/svelte": "^4.0.0",
    "@astrojs/mdx": "^3.0.0",
    "@astrojs/rss": "^4.0.0",
    "svelte": "^4.2.0",
    "sharp": "^0.33.0",
    "aplayer": "^1.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "tsx": "^4.19.0",
    "colorthief": "^2.4.0",
    "zod": "^3.23.0",
    "pagefind": "^1.1.0"
  },
  "lint-staged": {
    "src/config/**/*.ts": [
      "pnpm validate-config"
    ],
    "src/assets/**/*.{mp3,flac,wav,ogg}": [
      "pnpm validate-music"
    ]
  }
}
