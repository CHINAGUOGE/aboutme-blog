---
/**
 * 首页 — 占位页面
 * 后续 Phase 2 会替换为完整的文章列表 + Hero 区域
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
---

<BaseLayout>
  <section class="hero">
    <div class="hero-avatar">
      <img
        src={siteConfig.author.avatar}
        alt={siteConfig.author.name}
        width="128"
        height="128"
        loading="eager"
      />
    </div>

    <h1 class="hero-title">{siteConfig.title}</h1>
    <p class="hero-subtitle">{siteConfig.subtitle}</p>
    <p class="hero-bio">{siteConfig.author.bio}</p>
    <div class="hero-actions">
      <a href="/blog" class="btn btn-primary">看看文章 ✨</a>
      <a href="/about" class="btn btn-secondary">关于我</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1rem;
    gap: 1rem;
  }

  .hero-avatar img {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    border: 4px solid var(--color-theme-accent);
    box-shadow: 0 8px 30px color-mix(in srgb, var(--color-theme-accent) 25%, transparent);
    transition:
      transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 300ms ease;
  }

  .hero-avatar img:hover {
    transform: scale(1.08) rotate(3deg);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--color-theme-accent) 35%, transparent);
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-theme-text);
    margin: 0.5rem 0 0;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-theme-accent);
    margin: 0;
    font-weight: 500;
  }

  .hero-bio {
    font-size: 1rem;
    color: var(--color-theme-muted);
    margin: 0;
    max-width: 28rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-card);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease,
      background-color 200ms ease;
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px -5px rgba(0, 0, 0, 0.15);
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn-primary {
    background-color: var(--color-theme-accent);
    color: white;
  }

  .btn-primary:hover {
    background-color: color-mix(in srgb, var(--color-theme-accent) 85%, black);
  }

  .btn-secondary {
    background-color: var(--color-theme-card);
    color: var(--color-theme-text);
    border: 1px solid var(--color-theme-border);
  }

  .btn-secondary:hover {
    background-color: var(--color-theme-bg);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 2.5rem 1rem;
    }

    .hero-title {
      font-size: 1.75rem;
    }

    .hero-subtitle {
      font-size: 1.0625rem;
    }

    .hero-avatar img {
      width: 96px;
      height: 96px;
    }
  }
</style>
