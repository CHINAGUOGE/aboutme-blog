---
/**
 * PostCard.astro
 * 文章卡片组件
 *
 * 展示单篇文章摘要，用于列表页。
 * 支持封面图、分类、标签、置顶标记。
 */

import type { BlogPost } from "@/lib/posts";

interface Props {
  /** 文章数据 */
  post: BlogPost;
  /** 是否显示封面图 */
  showCover?: boolean;
  /** 卡片索引（用于动画延迟） */
  index?: number;
}

const { post, showCover = true, index = 0 } = Astro.props;

/** 格式化日期 */
function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
}

/** 文章链接 */
const href = `/blog/${post.slug}`;

/** 封面图（优先使用文章封面，否则使用默认） */
const coverSrc = post.data.cover || "";
---

<article
  class="post-card"
  style={`animation-delay: ${index * 60}ms`}
>
  {showCover && coverSrc && (
    <a href={href} class="post-card-cover">
      <img
        src={coverSrc}
        alt={post.data.title}
        loading="lazy"
        decoding="async"
      />
    </a>
  )}

  <div class="post-card-body">
    <!-- 分类 + 日期 -->
    <div class="post-card-meta">
      {post.data.category && (
        <a href={`/blog?category=${encodeURIComponent(post.data.category)}`} class="post-card-category">
          {post.data.category}
        </a>
      )}
      <time class="post-card-date" datetime={post.data.pubDate}>
        {formatDate(post.data.pubDate)}
      </time>
      {post.data.pinned && (
        <span class="post-card-pin" title="置顶文章">📌</span>
      )}
    </div>

    <!-- 标题 -->
    <h2 class="post-card-title">
      <a href={href}>{post.data.title}</a>
    </h2>

    <!-- 描述 -->
    <p class="post-card-desc">{post.data.description}</p>

    <!-- 标签 -->
    {post.data.tags.length > 0 && (
      <div class="post-card-tags">
        {post.data.tags.map((tag) => (
          <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="post-card-tag">
            #{tag}
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-card);
    background-color: var(--color-theme-card);
    border: 1px solid var(--color-theme-border);
    overflow: hidden;
    opacity: 0;
    transform: translateY(16px);
    animation: fade-up 0.4s var(--transition-easing) forwards;
    transition:
      transform var(--transition-fast) var(--transition-easing),
      box-shadow var(--transition-fast) var(--transition-easing),
      border-color var(--transition-fast) var(--transition-easing);
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 35px -8px rgba(0, 0, 0, 0.12);
    border-color: var(--color-theme-accent);
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 封面图 */
  .post-card-cover {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .post-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--transition-easing);
  }

  .post-card:hover .post-card-cover img {
    transform: scale(1.05);
  }

  .post-card-cover:hover {
    transform: none;
    box-shadow: none;
  }

  /* 卡片内容 */
  .post-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem;
    gap: 0.625rem;
  }

  /* 元信息行 */
  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.8125rem;
    color: var(--color-theme-muted);
  }

  .post-card-category {
    padding: 0.125rem 0.625rem;
    border-radius: 9999px;
    background-color: color-mix(in srgb, var(--color-theme-accent) 12%, transparent);
    color: var(--color-theme-accent);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.75rem;
    transition: background-color var(--transition-fast) ease;
  }

  .post-card-category:hover {
    background-color: color-mix(in srgb, var(--color-theme-accent) 20%, transparent);
    transform: none;
    box-shadow: none;
  }

  .post-card-date {
    font-variant-numeric: tabular-nums;
  }

  .post-card-pin {
    font-size: 0.875rem;
  }

  /* 标题 */
  .post-card-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .post-card-title a {
    color: var(--color-theme-text);
    text-decoration: none;
    transition: color var(--transition-fast) ease;
  }

  .post-card-title a:hover {
    color: var(--color-theme-accent);
    transform: none;
    box-shadow: none;
  }

  /* 描述 */
  .post-card-desc {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-theme-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 标签 */
  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .post-card-tag {
    font-size: 0.75rem;
    color: var(--color-theme-muted);
    text-decoration: none;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    background-color: color-mix(in srgb, var(--color-theme-muted) 8%, transparent);
    transition:
      color var(--transition-fast) ease,
      background-color var(--transition-fast) ease;
  }

  .post-card-tag:hover {
    color: var(--color-theme-accent);
    background-color: color-mix(in srgb, var(--color-theme-accent) 10%, transparent);
    transform: none;
    box-shadow: none;
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .post-card-body {
      padding: 1rem;
    }

    .post-card-title {
      font-size: 1rem;
    }
  }
</style>
