---
/**
 * Timeline.astro
 * 时间轴组件
 *
 * 垂直时间轴，展示事件列表。
 * 支持入场动画、自定义图标、响应式布局。
 */

interface TimelineEvent {
  /** 日期文本 */
  date: string;
  /** 事件标题 */
  title: string;
  /** 事件描述 */
  description?: string;
  /** 图标（emoji 或文本） */
  icon?: string;
}

interface Props {
  /** 事件列表（按时间正序） */
  events: TimelineEvent[];
}

const { events } = Astro.props;
---

<div class="timeline">
  {events.map((event, index) => (
    <div
      class="timeline-item"
      style={`animation-delay: ${index * 120}ms`}
    >
      <!-- 左侧：日期 + 连接线 -->
      <div class="timeline-left">
        <span class="timeline-date">{event.date}</span>
      </div>

      <!-- 中间：节点 -->
      <div class="timeline-center">
        <div class="timeline-node">
          {event.icon ? (
            <span class="timeline-icon">{event.icon}</span>
          ) : (
            <span class="timeline-dot" />
          )}
        </div>
        <div class="timeline-line" />
      </div>

      <!-- 右侧：内容卡片 -->
      <div class="timeline-right">
        <div class="timeline-card">
          <h3 class="timeline-title">{event.title}</h3>
          {event.description && (
            <p class="timeline-desc">{event.description}</p>
          )}
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0.5rem 0;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 100px 48px 1fr;
    gap: 0;
    opacity: 0;
    transform: translateY(16px);
    animation: fade-up 0.5s var(--transition-easing) forwards;
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 左侧日期 */
  .timeline-left {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding-top: 1rem;
    padding-right: 1rem;
  }

  .timeline-date {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-theme-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* 中间节点 + 连接线 */
  .timeline-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .timeline-node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--color-theme-card);
    border: 2px solid var(--color-theme-accent);
    flex-shrink: 0;
    z-index: 1;
    margin-top: 0.75rem;
    transition: background-color var(--transition-fast) ease;
  }

  .timeline-item:hover .timeline-node {
    background-color: color-mix(in srgb, var(--color-theme-accent) 12%, var(--color-theme-card));
  }

  .timeline-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .timeline-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-theme-accent);
  }

  .timeline-line {
    flex: 1;
    width: 2px;
    background-color: var(--color-theme-border);
    min-height: 1.5rem;
  }

  /* 最后一项不需要连接线 */
  .timeline-item:last-child .timeline-line {
    display: none;
  }

  /* 右侧内容卡片 */
  .timeline-right {
    padding-bottom: 1.5rem;
  }

  .timeline-card {
    margin-top: 0.5rem;
    margin-left: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-card);
    background-color: var(--color-theme-card);
    border: 1px solid var(--color-theme-border);
    transition:
      transform var(--transition-fast) var(--transition-easing),
      box-shadow var(--transition-fast) var(--transition-easing),
      border-color var(--transition-fast) var(--transition-easing);
  }

  .timeline-item:hover .timeline-card {
    transform: translateX(4px);
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.08);
    border-color: var(--color-theme-accent);
  }

  .timeline-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-theme-text);
    line-height: 1.4;
  }

  .timeline-desc {
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
    color: var(--color-theme-muted);
    line-height: 1.6;
  }

  /* 响应式：移动端改为左右交替 */
  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 32px 1fr;
      gap: 0;
    }

    .timeline-left {
      display: none;
    }

    .timeline-center {
      grid-row: 1 / 3;
    }

    .timeline-node {
      width: 28px;
      height: 28px;
    }

    .timeline-icon {
      font-size: 0.875rem;
    }

    .timeline-dot {
      width: 6px;
      height: 6px;
    }

    .timeline-card {
      margin-left: 0.5rem;
      padding: 0.875rem 1rem;
    }

    .timeline-title {
      font-size: 0.9375rem;
    }

    .timeline-date-mobile {
      display: block;
      font-size: 0.75rem;
      color: var(--color-theme-muted);
      margin-bottom: 0.25rem;
    }
  }
</style>
